# Только для npm run dev: Vite пересылает /api на этот backend.
# В Docker Compose эта переменная не используется — прокси настроен в nginx.conf.
API_PROXY_TARGET=http://127.0.0.1:8080

# Путь API для браузера: локально запросы пересылает Vite, в Docker Compose — Nginx.
# Для Docker-сборки значение /api задаётся в Dockerfile.
VITE_API_BASE_URL=/api

