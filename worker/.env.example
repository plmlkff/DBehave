# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_API_TOKEN=replace-with-a-long-random-secret

# PostgreSQL database used by the DBehave backend and worker.tasks queue.
WORKER_DB_HOST=127.0.0.1
WORKER_DB_PORT=5432
WORKER_DB_NAME=dbehave
WORKER_DB_USER=dbehave
WORKER_DB_PASSWORD=replace-with-database-password
WORKER_INSTANCE_ID=worker-1

# The worker's aggregate capacity across all concurrently running jobs.
WORKER_CAPACITY_CORES=8
WORKER_CAPACITY_MEMORY_MB=16384
WORKER_MAX_CONCURRENT_JOBS=4

# Only images with these normalized prefixes can be run.
# Example: postgres:16 becomes docker.io/library/postgres:16
# Add your own load-generator registry/namespace here.
WORKER_ALLOWED_IMAGE_PREFIXES=docker.io/library/,docker.io/dbehave/,ghcr.io/your-org/

WORKER_SCHEDULER_POLL_SECONDS=1.0
WORKER_METRICS_SCRAPE_SECONDS=2.0
# Optional. When set, worker process and task-container resource metrics are pushed here.
# WORKER_PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
WORKER_TMPFS_SIZE_MB=256
WORKER_PIDS_LIMIT=256
WORKER_LOG_MAX_SIZE=10m
WORKER_LOG_MAX_FILES=3

# Set true for production deployments using a rootless Docker daemon.
WORKER_REQUIRE_ROOTLESS_DOCKER=false
