{
  "uid": "dbheave-mongo",
  "title": "DBehave · MongoDB",
  "tags": [
    "dbehave",
    "mongodb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 10,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Источник",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "run_id",
        "label": "Запуски",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(dbehave_run_info{engine=\"mongo\"}, run_id)",
          "refId": "run_id"
        },
        "definition": "label_values(dbehave_run_info{engine=\"mongo\"}, run_id)",
        "refresh": 1,
        "sort": 4,
        "hide": 0,
        "multi": true,
        "includeAll": false
      },
      {
        "name": "run_offsets",
        "type": "textbox",
        "hide": 2,
        "query": "vector(0)",
        "current": {
          "text": "vector(0)",
          "value": "vector(0)"
        }
      },
      {
        "name": "run_window",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "query_result((${run_offsets:raw}) or on (run_id) (0 * max by (run_id) (max_over_time(dbehave_phase{run_id=~\"$run_id\"}[30d]))))",
          "refId": "run_window"
        },
        "definition": "query_result((${run_offsets:raw}) or on (run_id) (0 * max by (run_id) (max_over_time(dbehave_phase{run_id=~\"$run_id\"}[30d]))))",
        "regex": "/run_id=\"(?<value>${run_id:regex})\".*?\\s+(?<text>[0-9]+)/",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "skipUrlSync": true
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Запуски",
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "description": "Короткий ID совпадает с легендами. Полный текст настроек и параметров можно открыть из ячейки.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (run_short, settings, scenario, params) (label_replace(max_over_time(dbehave_run_info{run_id=~\"$run_id\"}[30d]), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\"))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "settings": 0,
              "scenario": 1,
              "params": 2,
              "run_short": 3
            },
            "renameByName": {
              "settings": "Настройки",
              "scenario": "Сценарий",
              "params": "Нагрузка",
              "run_short": "Запуск"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 90
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Сценарий"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Запуск"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Настройки"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Нагрузка"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "row",
      "title": "Запуск ${run_window:raw}",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "repeat": "run_window",
      "repeatDirection": "v"
    },
    {
      "type": "state-timeline",
      "title": "Фаза",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((((dbehave_phase{run_id=~\"${run_window:regex}\"} offset ${run_window:text}ms == 1)) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{phase}} · {{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": " ",
                  "color": "transparent"
                },
                "1": {
                  "text": "активна",
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      }
    },
    {
      "type": "stat",
      "title": "Прогресс фазы",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((dbehave_progress_percent{run_id=~\"${run_window:regex}\"} offset ${run_window:text}ms) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Активные клиенты",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((dbehave_clients_active{run_id=~\"${run_window:regex}\"} offset ${run_window:text}ms) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      }
    },
    {
      "type": "stat",
      "title": "Ошибок всего",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((sum by (run_id) (dbehave_errors_total{run_id=~\"${run_window:regex}\"} offset ${run_window:text}ms)) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      }
    },
    {
      "type": "text",
      "title": "",
      "id": 6,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"height:100%;display:flex;align-items:flex-end;box-sizing:border-box;padding:0 0 8px;border-bottom:1px solid rgba(145,153,164,0.25)\"><h2 style=\"margin:0;font-size:20px;font-weight:600;line-height:26px\">Клиенты</h2></div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Пропускная способность",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((sum by (run_id, op) (rate(dbehave_operations_total{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms))) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{op}} · {{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Успешных операций в секунду по типам"
    },
    {
      "type": "timeseries",
      "title": "Задержка p50 / p95 / p99",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((histogram_quantile(0.5, sum by (run_id, le, op) (rate(dbehave_operation_duration_seconds_bucket{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms)))) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "p50 {{op}} · {{run_short}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((histogram_quantile(0.95, sum by (run_id, le, op) (rate(dbehave_operation_duration_seconds_bucket{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms)))) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "p95 {{op}} · {{run_short}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((histogram_quantile(0.99, sum by (run_id, le, op) (rate(dbehave_operation_duration_seconds_bucket{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms)))) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "p99 {{op}} · {{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки по видам",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((sum by (run_id, op, kind) (rate(dbehave_errors_total{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms))) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{op}}: {{kind}} · {{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Например, memory_limit, operation_timeout и duplicate_key"
    },
    {
      "type": "timeseries",
      "title": "Подтверждённые записи в секунду",
      "id": 29,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((rate(dbehave_records_written_total{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms)) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Документы в успешно подтверждённых пачках write-heavy"
    },
    {
      "type": "text",
      "title": "",
      "id": 30,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"height:100%;display:flex;align-items:flex-end;box-sizing:border-box;padding:0 0 8px;border-bottom:1px solid rgba(145,153,164,0.25)\"><h2 style=\"margin:0;font-size:20px;font-weight:600;line-height:26px\">MongoDB</h2></div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Кеш WiredTiger",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((dbehave_mongo_cache_bytes{run_id=~\"${run_window:regex}\"} offset ${run_window:text}ms / 1048576) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{kind}} · {{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: МиБ",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Занятая память и настроенный лимит"
    },
    {
      "type": "timeseries",
      "title": "Чтения в кеш WiredTiger",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(((rate(dbehave_mongo_cache_pages_read_total{run_id=~\"${run_window:regex}\"}[$__rate_interval] offset ${run_window:text}ms)) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"${run_window:regex}\"}[1h] offset ${run_window:text}ms))), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\")",
          "legendFormat": "{{run_short}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Страницы, прочитанные в кеш за секунду"
    },
    {
      "type": "table",
      "title": "Данные и индексы на диске",
      "id": 33,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (run_short, collection, kind) (label_replace(last_over_time(dbehave_mongo_collection_bytes{run_id=~\"${run_window:regex}\"}[$__range] offset ${run_window:text}ms), \"run_short\", \"$1\", \"run_id\", \"^(.{8}).*\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
