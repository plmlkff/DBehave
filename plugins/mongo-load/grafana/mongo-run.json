      },
      "description": "Просмотренные документы, ключи индекса и число результатов контрольного запроса"
    },
    {
      "type": "stat",
      "title": "Отчёт использовал временные файлы",
      "id": 36,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(dbehave_mongo_report_used_disk{run_id=~\"$run_id\"}[$__range]) * on (run_id) group_left (settings) max by (run_id, settings) (max_over_time(dbehave_run_info{run_id=~\"$run_id\"}[1h]))",
          "legendFormat": "{{settings}} · {{run_id}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
