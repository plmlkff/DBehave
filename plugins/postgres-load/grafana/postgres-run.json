{
  "uid": "dbehave-postgres",
  "title": "DBehave · PostgreSQL",
  "tags": [
    "dbehave",
    "postgres"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Источник",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "run_id",
        "label": "Запуски",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(dbehave_phase, run_id)",
          "refId": "run_id"
        },
        "definition": "label_values(dbehave_phase, run_id)",
        "refresh": 1,
        "sort": 4,
        "hide": 0,
        "multi": true,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Запуски",
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "description": "Сценарий, настройки и параметры нагрузки выбранных запусков. В подписях графиков показаны первые 8 символов ID запуска; полный ID и настройки доступны в этой таблице.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (run_id, settings, scenario, params) (max_over_time(dbehave_run_info{run_id=~\"$run_id\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "settings": 0,
              "scenario": 1,
              "params": 2,
              "run_id": 3
            },
            "renameByName": {
              "settings": "Изменённые настройки PostgreSQL",
              "scenario": "Сценарий",
              "params": "Параметры нагрузки",
              "run_id": "Запуск"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "row",
      "title": "Ход запуска",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Этапы эксперимента",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(sum by (run_id) ((dbehave_phase{run_id=~\"$run_id\",phase=\"STARTING\"} * 1) or (dbehave_phase{run_id=~\"$run_id\",phase=\"PREPARING\"} * 2) or (dbehave_phase{run_id=~\"$run_id\",phase=\"WARMUP\"} * 3) or (dbehave_phase{run_id=~\"$run_id\",phase=\"LOAD\"} * 4) or (dbehave_phase{run_id=~\"$run_id\",phase=\"VERIFYING\"} * 5) or (dbehave_phase{run_id=~\"$run_id\",phase=\"DONE\"} * 6) or (dbehave_phase{run_id=~\"$run_id\",phase=\"FAILED\"} * 7)), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Запуск",
                  "color": "purple"
                },
                "2": {
                  "text": "Подготовка",
                  "color": "light-blue"
                },
                "3": {
                  "text": "Прогрев",
                  "color": "yellow"
                },
                "4": {
                  "text": "Нагрузка",
                  "color": "blue"
                },
                "5": {
                  "text": "Проверка",
                  "color": "orange"
                },
                "6": {
                  "text": "Завершён",
                  "color": "green"
                },
                "7": {
                  "text": "Ошибка",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "—",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Одна строка на запуск. Цвета этапов указаны в легенде; подробности видны при наведении. Промежутки без измерений остаются пустыми."
    },
    {
      "type": "stat",
      "title": "Прогресс последней фазы",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(last_over_time(dbehave_progress_percent{run_id=~\"$run_id\"}[$__range]), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "—",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "description": "Последний измеренный прогресс для каждого запуска. При ошибке последняя фаза может остаться незавершённой."
    },
    {
      "type": "stat",
      "title": "Пик активных клиентов",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(max_over_time(dbehave_clients_active{run_id=~\"$run_id\"}[$__range]), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "description": "Максимум одновременно работающих клиентов за выбранный период. После завершения текущее число клиентов становится нулевым; для сравнения здесь показан пик."
    },
    {
      "type": "stat",
      "title": "Ошибок всего",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(sum by (run_id) (max_over_time(dbehave_errors_total{run_id=~\"$run_id\"}[$__range])) or on (run_id) (0 * max_over_time(dbehave_clients_active{run_id=~\"$run_id\"}[$__range])), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "—",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "description": "Суммарное число ошибок по всем операциям каждого запуска за выбранный период. Ноль выводится только для запусков с измерениями нагрузчика."
    },
    {
      "type": "row",
      "title": "Клиенты",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Пропускная способность",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((sum by (run_id, op) (rate(dbehave_operations_total{run_id=~\"$run_id\"}[$__rate_interval]))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · {{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Успешных операций в секунду по типам"
    },
    {
      "type": "timeseries",
      "title": "Задержка p50 / p95 / p99",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((histogram_quantile(0.5, sum by (run_id, le, op) (rate(dbehave_operation_duration_seconds_bucket{run_id=~\"$run_id\"}[$__rate_interval])))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · p50 {{op}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((histogram_quantile(0.95, sum by (run_id, le, op) (rate(dbehave_operation_duration_seconds_bucket{run_id=~\"$run_id\"}[$__rate_interval])))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · p95 {{op}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((histogram_quantile(0.99, sum by (run_id, le, op) (rate(dbehave_operation_duration_seconds_bucket{run_id=~\"$run_id\"}[$__rate_interval])))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · p99 {{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки по видам",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((sum by (run_id, op, kind) (rate(dbehave_errors_total{run_id=~\"$run_id\"}[$__rate_interval]))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · {{op}}: {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "serialization_failure, deadlock, lock_timeout и т. д."
    },
    {
      "type": "timeseries",
      "title": "События сценария",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((sum by (run_id, name) (rate(dbehave_scenario_events_total{run_id=~\"$run_id\"}[$__rate_interval]))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · {{name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((dbehave_scenario_value{run_id=~\"$run_id\"}), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Повторы транзакций, неповторяемые чтения, удержание блокировки (blocker_holding = 1)"
    },
    {
      "type": "row",
      "title": "PostgreSQL",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Сессии",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((dbehave_db_connections{run_id=~\"$run_id\"}), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · {{state}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((dbehave_db_lock_waiters{run_id=~\"$run_id\"}), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · ждут блокировку"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Ожидания и долгие транзакции",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((dbehave_db_lock_wait_max_seconds{run_id=~\"$run_id\"}), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · самое долгое ожидание блокировки"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((dbehave_db_oldest_transaction_seconds{run_id=~\"$run_id\"}), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · возраст старейшей транзакции"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Транзакции в секунду",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((sum by (run_id, result) (rate(dbehave_db_transactions_total{run_id=~\"$run_id\"}[$__rate_interval]))), \"run\", \"$1\", \"run_id\", \"(.{8}).*\")",
          "legendFormat": "Запуск {{run}} · {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
