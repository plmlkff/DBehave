# Local development only. Replace credentials before exposing any service.
POSTGRES_DB=dbehave
POSTGRES_USER=dbehave
POSTGRES_PASSWORD=dbehave-local

WORKER_API_TOKEN=local-development-worker-token-change-me-please-32chars
WORKER_INSTANCE_ID=worker-local
WORKER_CAPACITY_CORES=2
WORKER_CAPACITY_MEMORY_MB=3072
WORKER_MAX_CONCURRENT_JOBS=2
WORKER_SCHEDULER_POLL_SECONDS=1
WORKER_METRICS_SCRAPE_SECONDS=2
WORKER_ALLOWED_IMAGE_PREFIXES=docker.io/library/,docker.io/dbehave/
WORKER_REQUIRE_ROOTLESS_DOCKER=false

FRONTEND_PORT=3000
BACKEND_PORT=8080
PROMETHEUS_PORT=9090
