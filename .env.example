# Local development only. Replace credentials before exposing any service.
POSTGRES_DB=dbehave
POSTGRES_USER=dbehave
POSTGRES_PASSWORD=dbehave-local

WORKER_API_TOKEN=local-development-worker-token-change-me-please-32chars
WORKER_INSTANCE_ID=worker-local
# Ресурсы, которые worker делит между запусками (на каждый запуск — пополам между БД и нагрузчиком).
# CAPACITY_* не может превышать то, что видит Docker (`docker info`): для Docker Desktop это memory
# и processors в .wslconfig. Для демонстрации и честных сравнений: 4 ядра и один запуск за раз —
# тогда БД получает 2 ядра и запуски не мешают друг другу.
WORKER_CAPACITY_CORES=2
WORKER_CAPACITY_MEMORY_MB=3072
WORKER_MAX_CONCURRENT_JOBS=2
# Данные БД: volume — одноразовый том на диске (честный fsync), tmpfs — в памяти
WORKER_DB_DATA_STORAGE=volume
WORKER_SCHEDULER_POLL_SECONDS=1
WORKER_METRICS_SCRAPE_SECONDS=2
WORKER_ALLOWED_IMAGE_PREFIXES=docker.io/library/,docker.io/dbehave/,docker.io/clickhouse/
WORKER_REQUIRE_ROOTLESS_DOCKER=false

FRONTEND_PORT=3000
BACKEND_PORT=8080
PROMETHEUS_PORT=9090
